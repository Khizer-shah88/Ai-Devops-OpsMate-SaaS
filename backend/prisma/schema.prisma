generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestType {
  review
  debug
  cicd
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  requests  Request[]
}

model Request {
  id        String   @id @default(cuid())
  userId    String
  type      RequestType
  input     String
  output    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}